      "parameters": {
        "jsCode": "// Captura a saída do Agente de IA\nconst agentOutput = $node[\"AI Agent\"].json[\"output\"];\n\nif (!agentOutput || agentOutput.trim() === \"\") {\n  return { full_message: \"✅ Todos os indicadores estão normais para hoje.\" };\n}\n\n// 1. Remove qualquer tag <data> que a IA possa ter gerado por engano\nconst cleanMessage = agentOutput.replace(/<data>[\\s\\S]*?<\\/data>/g, '').trim();\n\n// 2. Retorna o texto puro (o Google Chat já entende as quebras de linha naturais)\nreturn {\n  full_message: cleanMessage\n};"
